generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChatType {
  DIRECT
  GROUP
  CHANNEL
  SAVED
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  SUBSCRIBER
}

enum MessageType {
  TEXT
  MEDIA
  FILE
  VOICE
  LOCATION
  POLL
  CALL
  SYSTEM
}

enum EnvelopeType {
  MESSAGE
  CONTROL
  EPOCH
}

enum CallKind {
  AUDIO
  VIDEO
}

enum CallState {
  RINGING
  ACTIVE
  ENDED
  DECLINED
  MISSED
}

enum LastSeenVisibility {
  EVERYONE
  CONTACTS
  NONE
}

model User {
  id                  String             @id @default(cuid())
  username            String             @unique
  displayName         String
  email               String?            @unique
  passwordHash        String?
  identityKey         String
  signingKey          String
  bio                 String?
  avatarMediaId       String?
  avatar              MediaAsset?        @relation("UserAvatar", fields: [avatarMediaId], references: [id])
  lastSeenAt          DateTime?
  lastSeenVisibility  LastSeenVisibility @default(EVERYONE)
  readReceiptsEnabled Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  devices      Device[]
  authSessions AuthSession[]
  memberships  ChatMember[]
  messages     Message[]            @relation("MessageSender")
  receipts     MessageReceipt[]
  reactions    Reaction[]
  deletions    MessageDeletion[]
  votes        PollVote[]
  folders      Folder[]
  drafts       Draft[]
  calls        Call[]
  blocking     BlockedUser[]        @relation("blocker")
  blockedBy    BlockedUser[]        @relation("blocked")
  credentials  WebAuthnCredential[]
  linkTokens   LinkToken[]
  media        MediaAsset[]         @relation("UserMedia")
  ownedMedia   MediaAsset[]         @relation("MediaOwner")
}

model WebAuthnCredential {
  id         String   @id
  userId     String
  publicKey  String
  counter    Int      @default(0)
  transports String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  deviceInfo String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LinkToken {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Device {
  id              String    @id @default(cuid())
  userId          String
  name            String
  platform        String
  registrationId  Int
  identityKey     String
  signingKey      String
  signedPreKeyId  Int
  signedPreKey    String
  signedPreKeySig String
  lastActiveAt    DateTime  @default(now())
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  preKeys         PreKey[]
  sentMessages    Message[] @relation("senderDevice")
}

model PreKey {
  id        String    @id @default(cuid())
  userId    String
  deviceId  String
  keyId     Int
  publicKey String
  usedAt    DateTime?
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, keyId])
}

model Chat {
  id             String       @id @default(cuid())
  type           ChatType
  title          String?
  description    String?
  handle         String?      @unique
  isPublic       Boolean      @default(false)
  inviteCode     String?      @unique
  avatarMediaId  String?
  disappearAfter Int?
  seqCounter     Int          @default(0)
  createdById    String?
  lastMessageAt  DateTime     @default(now())
  createdAt      DateTime     @default(now())
  members        ChatMember[]
  messages       Message[]
  polls          Poll[]
  folderChats    FolderChat[]
  drafts         Draft[]
  calls          Call[]
}

model ChatMember {
  id          String     @id @default(cuid())
  chatId      String
  userId      String
  role        MemberRole @default(MEMBER)
  lastReadSeq Int        @default(0)
  mutedUntil  DateTime?
  pinned      Boolean    @default(false)
  archived    Boolean    @default(false)
  joinedAt    DateTime   @default(now())
  chat        Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
}

model Folder {
  id       String       @id @default(cuid())
  userId   String
  name     String
  emoji    String?
  position Int          @default(0)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats    FolderChat[]

  @@unique([userId, name])
}

model FolderChat {
  folderId String
  chatId   String
  folder   Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  chat     Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([folderId, chatId])
}

model Message {
  id                 String            @id @default(cuid())
  chatId             String
  senderId           String
  senderDeviceId     String
  type               MessageType
  seq                Int
  body               String?
  meta               String?
  replyToId          String?
  forwardedFromChat  String?
  forwardedFromUser  String?
  editedAt           DateTime?
  deletedForEveryone Boolean           @default(false)
  expiresAt          DateTime?
  createdAt          DateTime          @default(now())
  chat               Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender             User              @relation("MessageSender", fields: [senderId], references: [id])
  senderDevice       Device            @relation("senderDevice", fields: [senderDeviceId], references: [id])
  replyTo            Message?          @relation("replies", fields: [replyToId], references: [id])
  replies            Message[]         @relation("replies")
  receipts           MessageReceipt[]
  reactions          Reaction[]
  deletions          MessageDeletion[]
  envelopes          Envelope[]
  poll               Poll?

  @@unique([chatId, seq])
  @@index([chatId, createdAt])
}

model Envelope {
  id         String       @id @default(cuid())
  type       EnvelopeType
  chatId     String?
  messageId  String?
  fromUserId String
  fromDevice String
  toUserId   String
  toDeviceId String
  payload    String
  consumedAt DateTime?
  createdAt  DateTime     @default(now())
  message    Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([toUserId, toDeviceId, consumedAt])
  @@index([messageId])
}

model MessageReceipt {
  id          String    @id @default(cuid())
  messageId   String
  userId      String
  deliveredAt DateTime?
  readAt      DateTime?
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model MessageDeletion {
  messageId String
  userId    String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model Poll {
  messageId     String     @id
  chatId        String
  allowMultiple Boolean    @default(false)
  anonymous     Boolean    @default(false)
  closedAt      DateTime?
  message       Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chat          Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  votes         PollVote[]
}

model PollVote {
  pollMessageId String
  userId        String
  optionIndex   Int
  createdAt     DateTime @default(now())
  poll          Poll     @relation(fields: [pollMessageId], references: [messageId], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollMessageId, userId, optionIndex])
}

model Draft {
  chatId    String
  userId    String
  content   String
  updatedAt DateTime @updatedAt
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
}

model Call {
  id           String            @id @default(cuid())
  chatId       String
  initiatorId  String
  kind         CallKind
  state        CallState         @default(RINGING)
  startedAt    DateTime          @default(now())
  endedAt      DateTime?
  chat         Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  initiator    User              @relation(fields: [initiatorId], references: [id])
  participants CallParticipant[]
}

model CallParticipant {
  id       String    @id @default(cuid())
  callId   String
  userId   String
  joinedAt DateTime?
  leftAt   DateTime?
  call     Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
}

model MediaAsset {
  id            String   @id @default(cuid())
  ownerId       String
  kind          String
  mime          String
  size          Int
  width         Int?
  height        Int?
  durationMs    Int?
  waveform      String?
  storageKey    String
  createdAt     DateTime @default(now())
  owner         User     @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  avatarOfUsers User[]   @relation("UserAvatar")
  userMedia     User[]   @relation("UserMedia")
}

model BlockedUser {
  blockerId String
  blockedId String
  blocker   User   @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User   @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@unique([blockerId, blockedId])
}
